#!/usr/bin/env bash
# Run the official MCP conformance suite against Phantom.
# See test/conformance/README.md.
#
#     bin/conformance                       # every requirement set, both topologies
#     bin/conformance --scenario ping       # pass options to `npx conformance server`
#     TOPOLOGY=distributed bin/conformance --scenario tools-call-with-logging \
#       --spec-version 2025-11-25
set -euo pipefail

cd "$(dirname "$0")/.."

if [ "$#" -eq 0 ]; then
  exec mix test --only conformance
fi

case "${TOPOLOGY:-single}" in
  single) URL="http://127.0.0.1:4111/mcp" ;;
  distributed) URL="http://127.0.0.1:4110/mcp" ;;
  *) echo "TOPOLOGY must be single or distributed" >&2; exit 1 ;;
esac

LOG="$(mktemp -t phantom-conformance.XXXXXX)"
MIX_ENV=test mix run test/conformance/server.exs >"$LOG" 2>&1 &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true; rm -f "$LOG"' EXIT

for _ in $(seq 1 120); do
  grep -q "(distributed)" "$LOG" && break

  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    cat "$LOG"
    echo "Conformance server failed to start" >&2
    exit 1
  fi

  sleep 1
done

npx conformance server --url "$URL" "$@"
